#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

&lt {
    quick-tap-ms = <300>;
};


/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp E>,
                <&macro_release &kp CAPSLOCK>;
        };

        // Ctrl を押しながらホイール1ノッチ (Ctrl+ホイールと同じ拡大・縮小)
        zoom_in: zoom_in_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &msc SCRL_UP>,
                <&macro_release &kp LCTRL>;
        };

        zoom_out: zoom_out_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &msc SCRL_DOWN>,
                <&macro_release &kp LCTRL>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                &kp Q            &kp W              &kp E                 &kp R                   &kp T                                                  &kp Y        &kp U            &kp I              &kp O               &kp P
                &kp A            &mt LALT S         &mt LSHIFT D          &mt LGUI F              &mt LCTRL G                                            &mt RCTRL H  &mt RGUI J       &mt RSHIFT K       &mt RALT L          &kp BSPC
                &kp Z            &kp X              &kp C                 &kp V                   &kp B                                                  &kp N        &kp M            &kp COMMA          &kp DOT             &kp SQT
                &lt 4 ESC        &tog 1             &kp TAB               &none                   &lt 2 SPACE       &lt 3 INT5          &lt 3 GRAVE      &lt 2 ENTER  &none            &tog 1              &kp DELETE          &lt 4 SLASH
            >;
            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
                &kp TAB          &kp LC(W)          &kp LG(E)             &kp LC(LS(T))           &kp LC(T)                                                 &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MB4          &mkp MB5            &zoom_in
                &kp LC(A)        &kp LALT           &kp LSHIFT            &kp LGUI                &kp LCTRL                                                 &msc SCRL_UP &mkp MB1         &kp UP             &mkp MB2            &trans
                &kp LC(Z)        &kp LC(X)          &kp LC(C)             &kp LC(V)               &kp LC(Y)                                                 &msc SCRL_DOWN &kp LEFT       &kp DOWN           &kp RIGHT           &zoom_out
                &trans           &trans             &kp LG(V)             &trans                  &trans            &kp LG(LS(S))       &mkp MB3         &trans       &trans           &trans             &kp LC(LS(TAB))              &kp LC(TAB)
            >;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
                &kp PERCENT      &kp NUMBER_7       &kp NUMBER_8          &kp NUMBER_9            &kp LS(MINUS)                                             &msc SCRL_LEFT &msc SCRL_RIGHT  &mkp MB4           &mkp MB5            &zoom_in
                &kp LS(SQT)      &kp NUMBER_4       &kp NUMBER_5          &kp NUMBER_6            &kp MINUS                                              &msc SCRL_UP   &mkp MB1         &kp UP             &mkp MB2            &mkp MB3
                &kp SLASH        &kp NUMBER_1       &kp NUMBER_2          &kp NUMBER_3            &kp LS(SEMI)                                              &msc SCRL_DOWN &kp LEFT         &kp DOWN           &kp RIGHT           &zoom_out
                &trans           &kp NUMBER_0       &kp DOT               &trans                  &trans            &trans              &trans           &trans    &trans           &trans             &kp LC(LS(TAB))     &kp LC(TAB)
            >;
            sensor-bindings = <&encoder_msc SCRL_RIGHT SCRL_LEFT>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &kp LS(RBKT)                                           &kp LS(BSLH) &kp EXCLAMATION &kp QUESTION      &kp LBKT            &kp HASH
                &kp LG(TAB)      &kp LS(INT3)       &kp DOLLAR            &kp SLASH               &kp LS(N8)                                             &kp LS(N9)   &kp MINUS        &kp LS(EQUAL) &kp LS(LBKT)      &kp LS(N2)
                &trans           &trans             &trans                &kp INT1                &kp RBKT                                               &kp BSLH     &kp LS(INT1)    &kp EQUAL         &kp LS(N6)          &kp SEMICOLON
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
                &none            &none              &none                 &none                   &bt BT_CLR                                             &bt BT_SEL 0 &bt BT_SEL 1     &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_SEL 4
                &none            &none              &none                 &none                   &none                                                  &none        &none            &none              &none               &none
                &sys_reset       &none              &none                 &none                   &none                                                  &none        &none            &none              &none               &sys_reset
                &bootloader      &bt BT_CLR_ALL     &none                 &none                   &none             &none               &studio_unlock   &none        &none            &none              &none               &bootloader
            >;
        };

        layer_5 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
            >;
        };
    };

};
